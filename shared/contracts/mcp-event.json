{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpEvent",
  "description": "A single Fivetran MCP call as shown in the live MCP Activity Log.",
  "type": "object",
  "required": ["action", "status", "ts"],
  "properties": {
    "connector": {
      "type": ["string", "null"],
      "enum": ["github", "jira", "calendar", "pagerduty", null]
    },
    "action": { "type": "string", "description": "MCP tool name, e.g. sync_connector" },
    "status": { "type": "string", "enum": ["start", "success", "error"] },
    "ts": { "type": "string", "format": "date-time" },
    "payload": { "description": "Optional request/response detail" }
  }
}
