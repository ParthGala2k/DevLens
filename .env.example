# ============================================================================
# DevLens — environment variables
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# ============================================================================

# ---- Google Cloud / Vertex AI (Gemini 3, Agent Builder) ----
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Path to a service-account key JSON (local dev). On Cloud Run use the runtime SA instead.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Use Vertex AI backend for ADK/Gemini (1) vs. AI Studio API key (0)
GOOGLE_GENAI_USE_VERTEXAI=1
GEMINI_MODEL=gemini-3-pro

# ---- BigQuery (Fivetran sync target) ----
BIGQUERY_PROJECT=your-gcp-project-id
BIGQUERY_DATASET_GITLAB=gitlab
BIGQUERY_DATASET_JIRA=jira
BIGQUERY_DATASET_SLACK=slack
BIGQUERY_DATASET_CALENDAR=calendar
BIGQUERY_DATASET_PAGERDUTY=pagerduty
# Dataset holding our derived metric views (mr_review_lag, developer_load, ...)
BIGQUERY_DATASET_METRICS=devlens_metrics

# ---- Firestore (app state) ----
FIRESTORE_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE=(default)
# For local dev with the emulator (set by docker-compose); leave unset for real Firestore.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---- Fivetran MCP server (sync layer — mandatory partner integration) ----
FIVETRAN_MCP_URL=
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=
FIVETRAN_GROUP_ID=

# ---- GitLab MCP server (action layer — create/assign/label issues) ----
GITLAB_MCP_URL=
# Personal access token with `api` scope (permission to create issues)
GITLAB_TOKEN=
# Default target project for the discussion->repo bridge demo (numeric id or path)
GITLAB_PROJECT_ID=

# ---- Backend server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
